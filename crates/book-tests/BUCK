    name = "generated",
    srcs = ["//docs/src:markdown"],
    out = "generated",
    cmd = "mkdir -p \"$OUT\"; OUT_DIR=\"$OUT\" CARGO_MANIFEST_DIR=crates/book-tests EIDETICA_BOOK_DOCS=\"$SRCS\" $(exe :generator)",
)

