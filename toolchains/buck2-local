#!/usr/bin/env sh
# Resolve Nix-provided C tools to absolute paths: Reindeer's build-script shims use execve.
set -eu
command -v buck2 >/dev/null
for tool in clang clang++ ar; do
    command -v "$tool" >/dev/null || { echo "missing C tool: $tool" >&2; exit 1; }
done
command=${1:?usage: buck2-local build|test ...}
shift
exec buck2 "$command" \
    -c "cxx.compiler=$(command -v clang)" \
    -c "cxx.cxx_compiler=$(command -v clang++)" \
    -c "cxx.linker=$(command -v clang++)" \
    -c "cxx.archiver=$(command -v ar)" "$@"
